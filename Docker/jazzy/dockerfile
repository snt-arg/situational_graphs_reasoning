# Stage 0 – build image (CUDA 12.5.1 + Ubuntu 24.04 Noble)
ARG CUDA_VER=12.5.1
FROM nvidia/cuda:${CUDA_VER}-devel-ubuntu24.04 AS build

ENV DEBIAN_FRONTEND=noninteractive \
    LANG=C.UTF-8 \
    LC_ALL=C.UTF-8 \
    ROS_DISTRO=jazzy \
    PIP_BREAK_SYSTEM_PACKAGES=1

# ---------- Base OS tooling -------------------------------------------------
RUN rm -rf /var/lib/apt/lists/* && apt-get update && apt-get install -y --no-install-recommends \
        curl gnupg2 lsb-release \
        build-essential git cmake \
        python3-pip \
        locales && \
    locale-gen en_US.UTF-8

# ---------- Add the official ROS 2 APT repository ---------------------------
RUN curl -sSL https://raw.githubusercontent.com/ros/rosdistro/master/ros.key \
      | gpg --dearmor -o /usr/share/keyrings/ros-archive-keyring.gpg && \
    echo "deb [signed-by=/usr/share/keyrings/ros-archive-keyring.gpg] \
      http://packages.ros.org/ros2/ubuntu $(. /etc/os-release && echo $VERSION_CODENAME) main" \
      > /etc/apt/sources.list.d/ros2.list

# ---------- Install ROS tools & core packages ------------------------------
RUN apt-get update && apt-get install -y \
        python3-rosdep \
        python3-vcstool \
        ros-jazzy-ros-base \
        ros-dev-tools \
        python3-colcon-common-extensions && \
    rm -rf /var/lib/apt/lists/*

# ---------- Initialise rosdep ----------------------------------------------
RUN rosdep init && rosdep update

# ---------- Workspace setup -------------------------------------------------
WORKDIR /opt/ros_ws
RUN mkdir -p src

# ---- 1) Copy your *.rosinstall* manifest -----------------------------------
COPY jazzy_sources.rosinstall /tmp/jazzy_sources.rosinstall

# ---- 2) Fetch the repos/branches listed there ------------------------------
RUN vcs import src < /tmp/jazzy_sources.rosinstall

# ---- 3) Resolve & install system dependencies ------------------------------
RUN apt-get update && \
    rosdep install --from-paths src --rosdistro $ROS_DISTRO -y --ignore-src && \
    rm -rf /var/lib/apt/lists/*

# ---- 4) Build the workspace ------------------------------------------------
RUN . /opt/ros/$ROS_DISTRO/setup.sh && \
    colcon build --symlink-install --cmake-args -DCMAKE_BUILD_TYPE=Release

# Stage 1 – Slim runtime image
FROM nvidia/cuda:${CUDA_VER}-runtime-ubuntu24.04

ENV LANG=C.UTF-8 \
    LC_ALL=C.UTF-8 \
    ROS_DISTRO=jazzy \
    NVIDIA_VISIBLE_DEVICES=all \
    NVIDIA_DRIVER_CAPABILITIES=compute,utility

# Copy the built workspace
COPY --from=build /opt/ros_ws /opt/ros_ws

# Source ROS environment in every shell
RUN echo "source /opt/ros_ws/install/setup.bash" >> /etc/bash.bashrc

# ---------- Install CUDA dependencies after ROS installation -----------------
# Install CUDA runtime and necessary drivers for the image
RUN apt-get update && apt-get install -y \
    nvidia-driver-525 \
    cuda-toolkit-12-5 \
    cuda-runtime-12-5 && \
    rm -rf /var/lib/apt/lists/*

WORKDIR /workdir
CMD ["bash"]

